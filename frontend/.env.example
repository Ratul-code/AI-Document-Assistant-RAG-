# FastAPI backend origin. Used for REST (`/api/v1/*`) and the
# WebSocket (`/ws`). The browser opens the WS upgrade directly to
# this origin — no Next.js proxy.
#
# Local dev (matches backend/.env):
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
#
# Production (HTTPS, on a public host that the backend is also reachable on):
#   NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com
#
# Why HTTPS in production: the backend sets the `xs` access-token
# cookie with `SameSite=None; Secure`. Browsers will not send a
# `Secure` cookie over plain HTTP, so the WebSocket upgrade would
# fail with "no/invalid access_token" on the server. HTTPS is
# required for the cross-origin path to work.
#
# Local dev caveat: `Secure` cookies are dropped over plain HTTP,
# so local dev over `http://localhost:3000` → `http://localhost:8000`
# requires the backend to override `COOKIE_SECURE=false` and
# `COOKIE_SAMESITE=lax` (see backend/.env.example). The two configs
# must be kept in sync per environment.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
