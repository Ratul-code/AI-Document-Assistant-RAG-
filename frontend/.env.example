# =============================================================================
# Frontend environment — TEMPLATE. Copy to `.env.local` and edit.
# =============================================================================
#
# WHEN DO YOU NEED THIS FILE?
# ---------------------------
#   * Running the frontend OUTSIDE Docker (`npm run dev` / `npm run build`
#     in this directory)  -> YES, copy this to `.env.local`.
#   * Running the frontend in Docker (compose dev or prod)
#     -> NO. The value is supplied by Compose as a build arg / env var.
#
# Next.js loads env files automatically, in this order (first wins):
#
#     .env.development.local   (or .env.production.local)
#     .env.local
#     .env.development         (or .env.production)
#     .env
#
# `.env.local` is gitignored (see frontend/.gitignore), so anything you
# put here stays on your machine.
#
#
# ⚠️  THIS FILE IS TRACKED BY GIT. Never put a real secret here.
#     There is nothing secret about the frontend's config — it is all
#     public URLs that end up in the browser bundle anyway.
# =============================================================================


# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL — the origin the BROWSER calls.
#
# Used for both REST (`/api/v1/*`) and the WebSocket (`/ws`). The browser
# opens the WS upgrade directly to this origin — there is no Next.js proxy
# in front of it.
#
# The `NEXT_PUBLIC_` prefix is what makes this a BUILD-TIME value: Next.js
# inlines it into the client JavaScript bundle. Changing it requires a
# rebuild, not just a restart.
#
# --- Local dev (running `npm run dev` outside Docker) -----------------------
# The backend is on the host at port 8000:
#
#     NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
#
# --- Local dev (running the whole stack in Docker) -------------------------
# You do NOT need this file. compose.dev.yaml sets the value for you.
#
# --- Production ------------------------------------------------------------
# Set it to your PUBLIC origin — the same origin that serves the frontend:
#
#     NEXT_PUBLIC_API_BASE_URL=https://yourdomain.com
#
# The production stack serves the frontend and the API from ONE origin,
# with Caddy routing by path (/api/* and /ws go to the backend, everything
# else goes to the frontend). So this is the same URL you visit in the
# browser. Because both sides share an origin:
#
#   * the browser treats them as same-site, so the auth cookies work with
#     SameSite=lax (no third-party-cookie fragility),
#   * CORS is never exercised at all, and
#   * the WebSocket upgrade is same-origin, so no cross-site cookie drop.
#
# Do NOT set this to `http://api:8000`. That is a Docker-internal hostname
# that no browser outside the Docker network can resolve — every REST call
# and the WebSocket would fail with a DNS error while every container still
# looked healthy.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000


# -----------------------------------------------------------------------------
# API_INTERNAL_BASE_URL — the address the NEXT.JS SERVER uses.
#
# Server-side only (RSC layouts, route handlers, and the middleware in
# src/proxy.ts). It is NOT prefixed with NEXT_PUBLIC_, so Next.js replaces
# it with `undefined` in client bundles — the browser never sees it.
#
# You normally do NOT need to set this. It differs from
# NEXT_PUBLIC_API_BASE_URL only when the two halves of the app live on
# different hosts:
#
#   * Bare `next dev` on the host: the Next server and the backend are on
#     the same machine, so `http://localhost:8000` is correct for both
#     sides. The code falls back to NEXT_PUBLIC_API_BASE_URL automatically.
#
#   * Docker: the Next server runs in its own container, where
#     `localhost:8000` points back at ITSELF — nothing listens there, so
#     the fetch fails with ECONNREFUSED. It needs the in-network address
#     `http://api:8000`. Compose sets this for you (both dev and prod).
#
# Leave it commented out unless you are running the frontend outside Docker
# while the backend runs somewhere else.
#
# API_INTERNAL_BASE_URL=http://api:8000
