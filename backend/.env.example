# Copy to .env and fill in real values. Loaded automatically by pydantic-settings.

# --- App ---
APP_ENV=dev
APP_DEBUG=true

# --- Database ---
# Two URLs are needed:
#   1. DATABASE_URL          — used by the FastAPI app (async SQLAlchemy)
#   2. DATABASE_URL_SYNC     — used by Celery workers + Alembic (sync)
#
# For Supabase, grab both from the dashboard:
#   Project → Settings → Database → Connection string
#
# Recommended split:
#   * DATABASE_URL       → Supavisor **transaction** pooler on port 6543
#                          (the FastAPI app is a high-fan-out, short-
#                          transaction workload, which is exactly what
#                          the pooler is built for).
#   * DATABASE_URL_SYNC  → **Direct** connection on port 5432
#                          (Celery workers and Alembic DDL transactions
#                          should NOT go through the pooler — DDL like
#                          `CREATE TYPE` / `ALTER TABLE` cannot run
#                          inside a transaction-pool session, and long
#                          Celery tasks would hog a pooled connection).
#
# Append `?sslmode=require` to BOTH URLs — Supabase requires SSL.
# Use the same database name on both (usually `postgres`).
#
# Example (replace USER, PASSWORD, PROJECT_REF, REGION with your values):
#   DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
#   DATABASE_URL_SYNC=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
#
# Leave DATABASE_URL empty in dev to fall back to local SQLite (great
# for the first run / unit tests / offline work).
DATABASE_URL=postgresql://postgres:flaskDjango1234@db.tqpknsolgkrdgubqbuxr.supabase.co:5432/postgres
DATABASE_URL_FALLBACK=sqlite+aiosqlite:///./app.db
DATABASE_URL_SYNC=postgresql://postgres:flaskDjango1234@db.tqpknsolgkrdgubqbuxr.supabase.co:5432/postgres

# --- CORS ---
# Comma-separated list of allowed frontend origins. In production, set this to
# your real frontend URL(s). Example: https://app.example.com
# JSON array also works: CORS_ORIGINS='["https://app.example.com"]'
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# --- Auth cookies ---
# Controls the attributes of the `xs` (access) and `rfr` (refresh) cookies.
# These two values must match the transport in the environment.
#
# Production (HTTPS, cross-origin frontend):
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=none
# `SameSite=None` is required so the browser attaches the cookie to a
# cross-origin WebSocket upgrade from the frontend. `Secure` is
# required by the spec when `SameSite=None`. HTTPS is mandatory.
#
# Local dev (plain HTTP, cross-origin localhost):
#   COOKIE_SECURE=false
#   COOKIE_SAMESITE=lax
# Browsers drop `Secure` cookies over plain HTTP, so `SameSite=None;
# Secure` would silently never send the cookie on a local
# `http://localhost:3000` → `http://localhost:8000` upgrade. The
# `Lax` override keeps dev working. Do NOT use these values in
# production — `Secure=false` over public HTTPS is fine for the
# browser but `Lax` would re-create the original "no/invalid
# access_token cookie" rejection on the WebSocket path.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Supabase Storage ---
# Get these from your Supabase project: https://app.supabase.com → Settings → API
# The service-role key is SECRET: it bypasses RLS. Never expose it to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Bucket name (must already exist in your Supabase project)
SUPABASE_STORAGE_BUCKET=doc-uploads

# --- Embeddings ---
# Selects the embedding provider used by the Celery worker.
#   "stub"  → deterministic 16-dim hash vectors (default; tests + CI only).
#   "qwen3" → Qwen/Qwen3-Embedding-0.6B via sentence-transformers (1024-dim,
#             local, ~1.2 GB downloaded to ~/.cache/huggingface on first run).
EMBEDDING_PROVIDER=stub
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
# Use "mps" on Apple Silicon for GPU acceleration, "cpu" elsewhere.
EMBEDDING_DEVICE=cpu
# Must match the loaded model. Qwen3-Embedding-0.6B = 1024.
EMBEDDING_DIM=1024

# Upload limits
UPLOAD_MAX_SIZE_BYTES=52428800
UPLOAD_URL_TTL_SECONDS=300
# Comma-separated or JSON list, e.g. application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
UPLOAD_ALLOWED_MIME_TYPES=application/pdf

# --- Rate limiting (slowapi) ---
# Master switch. Set to false in tight-loop tests / local debugging.
# Per-route limits live in `backend/app/core/rate_limit.py` and are
# decorated on each handler (e.g. "@limiter.limit('5/minute')" on
# /auth/login).
RATE_LIMIT_ENABLED=true
# Storage backend for the limiter counters. We use Redis DB 2 (separate
# from Celery's DB 0 and WS pub/sub's DB 1). Format follows the `limits`
# library: `memory://` for single-process, `redis://host:port/db` for
# Redis. In production this MUST point at the same Redis used by Celery
# + WS pub/sub so all FastAPI workers share a count.
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/2

# --- Request ID middleware ---
# Stamps every HTTP request with a short unique ID. The ID is echoed
# on the response as `X-Request-ID` (configurable below) and stamped
# onto every log line emitted while the request is being processed —
# so a single `grep <id> app.log` returns the full request trail. If
# the incoming request already carries the header (common behind a
# load balancer), we trust and reuse the value; otherwise we mint a
# new 8-char URL-safe ID. See `backend/app/core/middleware.py`.
REQUEST_ID_HEADER=X-Request-ID
# Master switch. Set to false only in tight-loop load tests; off in
# dev/prod so every request is correlatable in the logs.
REQUEST_ID_ENABLED=true

# --- Retrieval / RAG (analysis endpoints) ---
# Top-K chunks surfaced to the LLM per query (1..50).
ANALYSIS_TOP_K=6
# Per-chunk character cap in the prompt.
ANALYSIS_SNIPPET_CHARS=800
# Soft context-token budget for the user prompt.
ANALYSIS_MAX_CONTEXT_TOKENS=3500
# Drop chunks with cosine score below this (0 disables the gate).
ANALYSIS_MIN_COSINE=0.0
# --- Retrieval mode (ADR-018) ---
# `hybrid` (default, recommended) = dense top-K + BM25 top-K → RRF.
# `dense` = cosine-only legacy path (safe fallback if BM25 misbehaves).
ANALYSIS_RETRIEVAL_MODE=hybrid
# Hybrid-only tunables (ignored in `dense` mode).
ANALYSIS_HYBRID_DENSE_K=15
ANALYSIS_HYBRID_BM25_K=15
ANALYSIS_HYBRID_RRF_K=60

# --- Reranker (ADR-019, opt-in) ---
# Post-retrieval reordering: the dense/BM25 → RRF (or cosine-only) retriever
# surfaces a pool of candidates, the reranker rescores the pool and the
# final K is what the LLM sees. Off by default so first-run demos don't
# pay the model download cost. Default model is BAAI/bge-reranker-base
# (~300 MB, English, runs on CPU/MPS).
#
# Set ANALYSIS_RERANK_ENABLED=true to turn it on. Provider "none" is the
# identity no-op (returns the pre-rerank order); "cross_encoder" uses a
# sentence-transformers CrossEncoder locally.
# ANALYSIS_RERANK_ENABLED=false
# ANALYSIS_RERANK_PROVIDER=cross_encoder
# ANALYSIS_RERANK_MODEL=BAAI/bge-reranker-base
# ANALYSIS_RERANK_DEVICE=cpu
# ANALYSIS_RERANK_TOP_K=6
# ANALYSIS_RERANK_POOL_MULTIPLIER=3
# ANALYSIS_RERANK_MAX_LENGTH=512
# ANALYSIS_RERANK_BATCH_SIZE=16
# ANALYSIS_RERANK_TIMEOUT_S=5.0

# --- LLM provider (analysis) ---
# Only "openai_compatible" is supported today. The same wire format is
# spoken by OpenAI, OpenRouter, Together, Anyscale, vLLM, etc.
#
# To use OpenRouter:
#   ANALYSIS_LLM_BASE_URL=https://openrouter.ai/api/v1
#   ANALYSIS_LLM_MODEL=openai/gpt-5.6-luna   # (or whatever slug OpenRouter shows)
#   ANALYSIS_LLM_API_KEY=sk-or-v1-...
#   ANALYSIS_LLM_HTTP_REFERER=http://localhost:3000
#   ANALYSIS_LLM_X_TITLE=AI Document Analyser
ANALYSIS_LLM_PROVIDER=openai_compatible
ANALYSIS_LLM_MODEL=gpt-4o-mini
ANALYSIS_LLM_BASE_URL=https://api.openai.com/v1
# Name of the env var that holds the API key. The key itself is read
# via os.environ at call time and is never stored in Settings.
ANALYSIS_LLM_API_KEY_ENV=ANALYSIS_LLM_API_KEY
# Set the key in your local .env (this file is the template).
# ANALYSIS_LLM_API_KEY=sk-...
# Optional attribution headers (recommended for OpenRouter, ignored by OpenAI).
ANALYSIS_LLM_HTTP_REFERER=
ANALYSIS_LLM_X_TITLE=
ANALYSIS_LLM_REQUEST_TIMEOUT_S=60
ANALYSIS_LLM_MAX_OUTPUT_TOKENS=800
ANALYSIS_LLM_TEMPERATURE=0.2
# Hard cap on simultaneous analysis streams per user.
ANALYSIS_MAX_CONCURRENT_STREAMS_PER_USER=3
