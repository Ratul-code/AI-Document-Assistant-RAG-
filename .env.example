# =============================================================================
# AI Document Analyser — VPS deployment environment template
# =============================================================================
#
# WHAT THIS FILE IS
# -----------------
# The variables Docker Compose needs at DEPLOY time, as opposed to
# `backend/.env` (which holds what the APPLICATION needs).
#
# The split:
#
#   backend/.env   → the app's own config: database URL, API keys, JWT
#                    secret, retrieval tuning, LLM settings.
#                    Read by the api/worker/beat containers.
#
#   .env (root)    → the deploy-time config: which domain you serve,
#                    which public URL the browser should call, which
#                    image tag to run.
#                    Read by Docker Compose itself when interpolating
#                    ${VAR} in the compose files.
#
# Both files are gitignored. Neither is ever committed.
#
#
# HOW TO USE
# ----------
# On the VPS, after `git clone`:
#
#   cp .env.example .env
#   nano .env          # fill in DOMAIN + NEXT_PUBLIC_API_BASE_URL
#
# Then set the real secrets in `backend/.env` (see backend/.env.example
# for the full list of what the app needs).
#
# Then:
#
#   docker compose -f compose.yaml -f compose.prod.yaml -f compose.vps.yaml up -d --build
#
#
# ⚠️  THIS FILE IS TRACKED BY GIT. NEVER PUT REAL SECRETS IN IT.
#     A domain name is not a secret and is safe to commit. A password or
#     API key is — those belong in `backend/.env`.
# =============================================================================


# -----------------------------------------------------------------------------
# DOMAIN — your public hostname.
#
# Used by:
#   * Caddy — expanded into the `{$DOMAIN}` placeholder in the Caddyfile.
#     Caddy requests an automatic Let's Encrypt certificate for it.
#   * Compose — to fail fast if you forgot to set it.
#
# MUST be a domain whose DNS A record already points at this VPS's public
# IP, otherwise the ACME HTTP-01 challenge cannot complete and Caddy will
# not start.
#
# No protocol, no trailing slash, no port. Just the hostname.
# -----------------------------------------------------------------------------
DOMAIN=yourdomain.com


# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL — the public origin the BROWSER calls.
#
# This is the single most important setting for a production deploy.
#
# It is inlined into the client JavaScript bundle at BUILD time (that's
# what the NEXT_PUBLIC_ prefix means in Next.js). It is NOT read at
# runtime. So:
#
#   * Change it  -> you must rebuild the frontend image.
#   * Get it wrong -> every REST call and the WebSocket fail with a DNS
#     error in the browser, while every container still looks healthy.
#     This is the #1 cause of "the site loads but nothing works".
#
# Set it to your PUBLIC origin — the same value as DOMAIN, with https://.
# Because Caddy serves both the frontend and the API on this one origin,
# the browser only ever talks to Caddy; Caddy routes the paths to the
# right container internally.
#
# Do NOT set this to http://api:8000 — that is a Docker-internal
# hostname that no browser outside the Docker network can resolve.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://yourdomain.com


# -----------------------------------------------------------------------------
# IMAGE_TAG — which image version to run.
#
# With the build-on-VPS workflow (compose.vps.yaml) the tag is mostly
# cosmetic: the image is built locally and tagged with this name.
# It is still worth setting, so you can tell at a glance which version
# a running container is on:
#
#   docker compose -f compose.yaml -f compose.prod.yaml -f compose.vps.yaml ps
#
# Bump it whenever you deploy a change, e.g. IMAGE_TAG=v1.5.0
# -----------------------------------------------------------------------------
IMAGE_TAG=latest


# -----------------------------------------------------------------------------
# APP_ENV — must be "prod" in production.
#
# This single switch activates the fail-fast configuration validator in
# backend/app/core/config.py. With APP_ENV=prod the app REFUSES TO BOOT
# unless all of the following are correct:
#
#   * JWT_SECRET is set and at least 32 characters long
#   * APP_DEBUG is false
#   * COOKIE_SECURE is true
#   * DATABASE_URL is set (not empty)
#   * CORS_ORIGINS points at your real origin, not localhost
#
# It also logs a loud warning if EMBEDDING_PROVIDER is still "stub".
#
# You normally set APP_ENV in backend/.env as well; this entry is here
# so the compose interpolation has a single source of truth.
# -----------------------------------------------------------------------------
APP_ENV=prod
